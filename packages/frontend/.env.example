# fhex402 frontend environment
# Copy to packages/frontend/.env and fill after deployment.

VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Optional in production. Leave empty for local Vite proxy.
# Example: https://ghostpay-api.your-domain.com
VITE_API_BASE_URL=

VITE_AGENT_VAULT_ADDRESS=
VITE_CONFIDENTIAL_PAYROLL_ADDRESS=
VITE_CONFIDENTIAL_PAYROLL_TOKEN_ADDRESS=
VITE_REGISTRY_ADDRESS=

VITE_FHEVM_GATEWAY_URL=https://gateway.sepolia.zama.ai

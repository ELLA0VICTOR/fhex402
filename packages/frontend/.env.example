# ─────────────────────────────────────────────────────────
# fhex402 Frontend Environment Variables
# Copy to .env and fill in values after deploying contracts
# ─────────────────────────────────────────────────────────

# Sepolia RPC (Infura / Alchemy / public)
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Deployed contract addresses (set after `npm run deploy:sepolia`)
VITE_AGENT_VAULT_ADDRESS=
VITE_CONFIDENTIAL_PAYROLL_ADDRESS=
VITE_REGISTRY_ADDRESS=

# Zama FHEVM Gateway (https://docs.zama.org/protocol/protocol-apps/addresses/testnet/sepolia)
VITE_FHEVM_GATEWAY_URL=https://gateway.sepolia.zama.ai

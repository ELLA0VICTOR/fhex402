# ─────────────────────────────────────────────────────────
# fhex402 Services Environment Variables
# Copy to .env in packages/services/
# ─────────────────────────────────────────────────────────

# x402 Facilitator (handles payment verification)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Demo mode: true = simulate transfers without real on-chain txs
# Set to false for live Sepolia USDC transfers
DEMO_MODE=true

# Wallet addresses that receive x402 payments for each service
ROSTER_WALLET_ADDRESS=0xYourRosterServiceWallet
COMPLIANCE_WALLET_ADDRESS=0xYourComplianceServiceWallet
DISBURSE_WALLET_ADDRESS=0xYourDisbursServiceWallet

# Sepolia RPC (used by DisbursAPI for live transfers when DEMO_MODE=false)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Private key for live disbursement signing (DEMO_MODE=false only)
# NEVER commit this to git
DISBURSEMENT_PRIVATE_KEY=

# Optional: salt for deterministic ciphertext generation
CYCLE_SALT=fhex402-demo-2024

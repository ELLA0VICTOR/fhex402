# fhex402 services environment
# Copy to packages/services/.env and fill locally. Never commit real secrets.

NODE_ENV=production

# Production/live mode. Set DEMO_MODE=true only for local protocol dry-runs.
DEMO_MODE=false
X402_LIVE=true

# x402 payment network/facilitator.
# The public x402 facilitator commonly supports Base Sepolia (eip155:84532).
# Ethereum Sepolia x402 needs a facilitator that explicitly supports eip155:11155111.
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# Wallet addresses that receive x402 service-call payments.
ROSTER_WALLET_ADDRESS=0xYourRosterServiceWallet
COMPLIANCE_WALLET_ADDRESS=0xYourComplianceServiceWallet
DISBURSE_WALLET_ADDRESS=0xYourDisbursServiceWallet

# Roster configuration.
ROSTER_ADMIN_TOKEN=replace_with_a_long_random_admin_token
ROSTER_DATA_PATH=roster-api/data/roster.local.json
PLAINTEXT_ROSTER_PATH=roster-api/data/roster.plain.local.json

# Ethereum Sepolia contracts/RPC used by the Zama FHE payroll agent.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
AGENT_VAULT_ADDRESS=0xYourAgentVault
CONFIDENTIAL_PAYROLL_ADDRESS=0xYourConfidentialPayroll
CONFIDENTIAL_PAYROLL_TOKEN_ADDRESS=0xYourGhostPayrollToken

# Salary settlement mode.
# confidential_token = Zama/FHE encrypted salary token on Ethereum Sepolia.
# public_usdc = fallback public testnet USDC transfer, not private.
DISBURSEMENT_MODE=confidential_token

# Base Sepolia is used only by the optional public_usdc fallback.
# x402 service fees still use X402_NETWORK above.
DISBURSEMENT_NETWORK=eip155:84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DISBURSEMENT_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Agent/disbursement key. Use a funded testnet wallet only.
DISBURSEMENT_PRIVATE_KEY=your_private_key_with_0x_prefix

# Only used by public_usdc fallback.
DISBURSEMENT_AMOUNT_USDC=0.01

# Optional. If omitted, prepare:roster funds exactly one payroll cycle.
TREASURY_FUND_USDC=

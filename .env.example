# ─────────────────────────────────────────────────────────
# fhex402 — Environment Variables
# ─────────────────────────────────────────────────────────

# ── Contracts ────────────────────────────────────────────
PRIVATE_KEY=your_deployer_private_key_here
AGENT_ADDRESS=your_agent_wallet_address_here
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
ETHERSCAN_API_KEY=your_etherscan_key

# ── Zama FHEVM (https://docs.zama.org/protocol/protocol-apps/addresses/testnet/sepolia) ──
FHEVM_GATEWAY_ADDRESS=
FHEVM_ACL_ADDRESS=
FHEVM_KMSVERIFIER_ADDRESS=
FHEVM_INPUTVERIFIER_ADDRESS=

# ── Frontend ─────────────────────────────────────────────
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
VITE_AGENT_VAULT_ADDRESS=          # Set after deploy
VITE_CONFIDENTIAL_PAYROLL_ADDRESS= # Set after deploy
VITE_FHEVM_GATEWAY_URL=https://gateway.sepolia.zama.ai

# ── Services (x402) ──────────────────────────────────────
DEMO_MODE=true
X402_FACILITATOR_URL=https://x402.org/facilitator
ROSTER_WALLET_ADDRESS=0x...        # Receives RosterAPI payments
COMPLIANCE_WALLET_ADDRESS=0x...    # Receives ComplianceAPI payments
DISBURSE_WALLET_ADDRESS=0x...      # Receives DisbursAPI payments
